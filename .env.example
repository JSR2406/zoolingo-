# Required by OpenCode MCP configuration (opencode.json).
# Copy to .env and fill in. Never commit .env.

# GitHub MCP (mandatory). GitHub does not support OAuth auto-discovery in OpenCode,
# so a Personal Access Token is required.
# Create: https://github.com/settings/tokens (scopes: repo, workflow, read:org)
GITHUB_PAT=

# Context7 MCP (optional — higher rate limits). Free key from https://context7.com
CONTEXT7_API_KEY=

# Vercel / Cloudflare / Fetch (Cloudflare Browser Run) / Sentry:
# authenticated interactively, no env vars needed.
#   opencode mcp auth vercel
#   opencode mcp auth cloudflare
#   opencode mcp auth fetch
#   opencode mcp auth sentry
# Tokens are stored in ~/.local/share/opencode/mcp-auth.json — do not commit that file.

# GenStudio (genstudio/.env): Hugging Face + Sarvam voice
HF_TOKEN=                         # fine-grained token with write access (huggingface.co/settings/tokens)
SARVAM_API_KEY=                   # for the optional voice tab (sarvam.ai)
