# ============================================
# ZooLingo Environment Configuration
# ============================================

# SARVAM AI (India's Sovereign AI) - PRIMARY TTS
# Get ₹1,000 free credits: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_key_here
# Default voice used when no voice is requested (also the hi-IN default)
SARVAM_VOICE_ID=shubh
SARVAM_LANGUAGE=hi-IN

# Available voices (SARVAM Bulbul v3) - validated in services/sarvam_integration.py
#   hi-IN: shubh (male), ritu (female), tanya (child)
#   en-IN: neha (female), rohan (male)
# The frontend fetches these from /api/languages and passes `voice` on every request.

# ElevenLabs - Sound-effect generation for the dog/cat demo mode
# Get a key: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Murf Falcon TTS - FALLBACK TTS
# Get 1M free characters: https://murf.ai
MURF_API_KEY=your_murf_key_here

# Deepgram ASR - Speech-to-Text
# Get $200 free credits: https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_key_here

# Flask Configuration
SECRET_KEY=your_secret_key_here
FLASK_ENV=development
FLASK_DEBUG=True

# CORS Settings
CORS_ORIGINS=http://localhost:3000,https://zoolingo.vercel.app

# Dataset Paths
DATASET_PATH=./data/training

# Model Configuration
MODEL_PATH=./backend/models
MODEL_FILE=cnn_rnn_model.h5

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=./backend/app.log

# ============================================
# SARVAM-SPECIFIC SETTINGS
# ============================================

USE_SARVAM=True
USE_SARVAM_LLM=True
API_PORT=8001

# ============================================
# Supabase (PostgreSQL) - Pet data storage
# Get keys from: https://supabase.com/dashboard -> Project -> Settings -> API
# SUPABASE_URL: Project URL (e.g., https://xxx.supabase.co)
# SUPABASE_ANON_KEY: Public anon key (for frontend)
# SUPABASE_SERVICE_ROLE_KEY: Service role key (backend only, keep secret!)
# ============================================
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# TESTING & DEPLOY NOTES
# ============================================
# Voice x Record matrix (60 combos): python test_voice_matrix.py --report demo/voice_matrix_report.md
# On Vercel: set the same vars as platform env vars (SARVAM_API_KEY, ELEVENLABS_API_KEY,
# ENVIRONMENT=production, ALLOWED_ORIGINS=https://<project>.vercel.app). VERCEL=1 switches
# the backend to /tmp scratch + data-URI TTS automatically.
