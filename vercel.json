{
  "version": 2,
  "installCommand": "npm --prefix frontend install --no-fund --no-audit",
  "buildCommand": "npm --prefix frontend run build",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "backend/**",
          "demo_audio/**",
          "data/test/elevenlabs/**"
        ]
      }
    },
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static",
      "config": { "cleanUrls": false }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/static/(.*)", "dest": "api/index.py" },
    { "src": "/demo-audio/(.*)", "dest": "api/index.py" },
    { "src": "/elevenlabs/(.*)", "dest": "api/index.py" },
    { "src": "/health", "dest": "api/index.py" },
    { "src": "/docs", "dest": "api/index.py" },
    { "src": "/openapi.json", "dest": "api/index.py" },
    { "src": "/assets/(.*)", "dest": "/frontend/dist/assets/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/dist/index.html" }
  ],
  "env": {
    "BE_BACKEND_DIR": "backend"
  }
}